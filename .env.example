# Server-only configuration; put real values in ignored .env.local or hosting secrets.
# Resend is selected. Leave unconfigured until the sender and hosting safeguards are confirmed.
CONTACT_ORIGIN=
CONTACT_TO=
CONTACT_FROM=
CONTACT_FORM_SECRET=
RESEND_API_KEY=
CONTACT_CLIENT_IP_HEADER=
CONTACT_RATE_LIMIT_MODE=
# Vercel uses vercel-postgres with a dedicated Neon database and stable namespace.
# CONTACT_CLIENT_IP_HEADER may be blank there; x-vercel-forwarded-for is fixed.
CONTACT_DATABASE_URL=
CONTACT_STATE_NAMESPACE=
